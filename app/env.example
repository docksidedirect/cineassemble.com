# ═══════════════════════════════════════════════════════════════
# CineAssemble — Environment Configuration
# Copy this file to .env and fill in your real values
# ═══════════════════════════════════════════════════════════════

# ── REQUIRED: Database ──
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/cineassemble

# ── REQUIRED: OpenAI (Script + Images + TTS) ──
OPENAI_API_KEY=sk-your-openai-key-here

# ── REQUIRED: Replicate (Video Animation) ──
REPLICATE_API_TOKEN=r8-your-replicate-token-here

# ── OPTIONAL: Fal.ai (Video Animation) ──
# FAL_KEY=your-fal-key-here

# ── Animation Engine: replicate | fal | local ──
ANIMATION_ENGINE=replicate

# ── Video Models ──
REPLICATE_VIDEO_MODEL=kwaivgi/kling-v2.1
FAL_VIDEO_MODEL=fal-ai/kling-video/v1-6-standard

# ── Image / Voice Models ──
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=high
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_SCRIPT_MODEL=gpt-4o

# ── App Settings ──
APP_SECRET=change-this-to-a-32-char-random-string-in-production
APP_URL=http://localhost:3001
PORT=3001
NODE_ENV=development

# ── MySQL (fallback if DATABASE_URL not used) ──
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=cineassemble
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=cineassemble

# ── File Storage ──
DATA_ROOT=./data
TEMP_ROOT=./data/tmp
PRIVATE_STORAGE_ROOT=./data/private
STORAGE_PROVIDER=local

# ── Assembly / Pipeline ──
UPSCALE_ENABLED=true
FALLBACK_TO_LOCAL=true
BURN_SUBTITLES=true

# ── Pipeline Tuning ──
SCENE_SECONDS_TARGET=9
CLIP_SECONDS=5
IMAGE_CONCURRENCY=2
VIDEO_CONCURRENCY=2

# ── Optional: PayPal (only needed for billing) ──
# PAYPAL_ENVIRONMENT=sandbox
# PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_CLIENT_SECRET=your-paypal-secret
# PAYPAL_WEBHOOK_ID=
# PAYPAL_PLAN_STARTER=
# PAYPAL_PLAN_CREATOR=
# PAYPAL_PLAN_STUDIO=

# ── Optional: SMTP (only needed for email) ──
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@your-domain.com
# SMTP_SECURE=false

# ── System ──
PYTHON_BIN=python
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
