    classDef data fill:#101827,stroke:#38bdf8,color:#fff;
    classDef secure fill:#17231b,stroke:#34d399,color:#fff;
    class WEB,WORKER,PIPE,FFMPEG edge;
    class DB,STORE data;
    class AUTH,ADMIN,MEDIA secure;
