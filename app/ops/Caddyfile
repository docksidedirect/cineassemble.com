{
	email {$ACME_EMAIL:}
	admin off
}

{$CADDY_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 25MB
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	reverse_proxy web:3001 {
		health_uri /health/live
		health_interval 30s
		health_timeout 5s
	}

	log {
		output stdout
		format json
	}
}
